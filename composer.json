{
    "name": "tomaj/omnipay-vub",
    "description": "VÚB e-platby (VÚB banka) gateway for the Omnipay payment processing library",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "eplatby",
        "vub",
        "epay",
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment",
        "slovakia"
    ],
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com",
            "homepage": "http://www.tomaj.sk/"
        }
    ],
    "homepage": "https://tomaj.github.io/omnipay-vub/",
    "support": {
        "issues": "https://github.com/tomaj/omnipay-vub/issues",
        "source": "https://github.com/tomaj/omnipay-vub",
        "docs": "https://tomaj.github.io/omnipay-vub/",
        "security": "https://github.com/tomaj/omnipay-vub/security/policy"
    },
    "require": {
        "php": "^8.3",
        "ext-hash": "*",
        "omnipay/common": "^3.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "php-http/guzzle7-adapter": "An HTTP client for Omnipay (omnipay/common needs a PSR-18/HTTPlug client implementation)"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Omnipay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\Eplatby\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ],
        "cs-fix": "php-cs-fixer fix",
        "phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    }
}
